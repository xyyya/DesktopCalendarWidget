<Window x:Class="DesktopCalendarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopCalendarWidget"
        Title="Desktop Widget" Height="320" Width="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize"
        
        >

    <Window.Resources>
        <!-- 任务日历小蓝点转换器 -->
        <local:TaskDayToVisibilityConverter x:Key="TaskDayToVisibilityConverter"/>

        <!-- 1. 消除焦点虚线框 -->
        <Style x:Key="NoFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 日期按钮样式 (集成小蓝点标记) -->
        <Style x:Key="CustomCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1">
                            <!-- 使用 Grid 垂直排列数字与小蓝点 -->
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 日期数字 -->
                                <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- 小蓝点指示器 (未完成任务时显示) -->
                                <Ellipse Grid.Row="1" Width="4" Height="4" Fill="#60A5FA" Margin="0,2,0,0"
                                         HorizontalAlignment="Center"
                                         Visibility="{Binding Path=DataContext, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TaskDayToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#38383D"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#555558"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter Property="Foreground" Value="#60A5FA"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. 年/月视图按钮样式 -->
        <Style x:Key="CustomCalendarButton" TargetType="{x:Type CalendarButton}">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarButton}">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#38383D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. 重构 CalendarItem -->
        <Style x:Key="CustomCalendarItemStyle" TargetType="{x:Type CalendarItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarItem}">
                        <Grid x:Name="PART_Root">
                            <Border Background="Transparent" BorderThickness="0" Padding="0">
                                <Grid Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 顶部导航栏 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#A0A0A5"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="#38383D"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="&lt;" Width="28" Height="28" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                                        <Button x:Name="PART_HeaderButton" Grid.Column="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand"/>
                                        <Button x:Name="PART_NextButton" Grid.Column="2" Content="&gt;" Width="28" Height="28" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- 7x7 日期网格 -->
                                    <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>

                                    <!-- 年/月视图网格 -->
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 5. Calendar 组装样式 -->
        <Style x:Key="CustomCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource CustomCalendarItemStyle}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CustomCalendarDayButton}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource CustomCalendarButton}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Calendar}">
                        <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                            <CalendarItem x:Name="PART_CalendarItem"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Style="{TemplateBinding CalendarItemStyle}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 6. 内嵌抽屉中的通用输入框/下拉框样式 -->
        <Style x:Key="DrawerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 7. 抽屉关闭按钮 (✕) 样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 暗黑 ComboBox 样式 -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <Border x:Name="BackgroundBorder" 
                                    Background="#222226" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    HorizontalAlignment="Left"
                                                    IsHitTestVisible="False"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                    <Path Grid.Column="1"
                                        x:Name="ArrowPath"
                                        Data="M 0 0 L 4 4 L 8 0 Z"
                                        Fill="#9CA3AF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                    <ToggleButton Grid.ColumnSpan="2"
                                                Focusable="False"
                                                ClickMode="Press"
                                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#1E1E22"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层卡片 -->
    <Border Background="#18181A" CornerRadius="16" BorderBrush="#2D2D30" BorderThickness="1.5" Margin="10" ClipToBounds="True">
        <Grid>
            <!-- 1. 主视图层 (左侧日历 + 右侧待办) -->
            <Grid x:Name="MainContentView" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：日历区域 -->
                <Border Grid.Column="0" Background="#222226" CornerRadius="10" Padding="8">
                    <Viewbox Stretch="Uniform">
                        <Calendar Name="MainCalendar" 
                                  Style="{StaticResource CustomCalendarStyle}"
                                  SelectedDatesChanged="MainCalendar_SelectedDatesChanged"/>
                    </Viewbox>
                </Border>

                <!-- 中间分隔线 -->
                <Rectangle Grid.Column="1" Width="1" Fill="#2D2D30" HorizontalAlignment="Center"/>

                <!-- 右侧：Tasks 待办区 -->
                <Grid Grid.Column="2" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Tasks" Foreground="#F0F0F0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="Settings_Click" Foreground="#E0E0E0" Background="#2D2D30" 
                                    BorderThickness="0" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="软件设定">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#E0E0E0" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.53,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.47,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.47,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.53,18.95 19.66,18.73L21.66,15.27C21.79,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            
                            <Button Click="History_Click" Foreground="#E0E0E0" Background="#2D2D30" 
                                    BorderThickness="0" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="历史记录">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#E0E0E0" Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3M12,8V13L16.28,15.54L17,14.33L13.5,12.25V8H12Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Button Content="＋" Click="AddTask_Click" Foreground="White" Background="#2D2D30" 
                                    BorderThickness="0" Width="26" Height="26" Cursor="Hand" ToolTip="新建任务">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="TaskListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 2. 内嵌滑动抽屉：新建/编辑任务 -->
            <Border x:Name="TaskEditDrawer" Background="#18181A" Panel.ZIndex="10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TaskEditTransform" X="600"/>
                </Border.RenderTransform>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="lblDrawerTitle" Text="新建任务" Foreground="#F0F0F0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseDrawers_Click" Style="{StaticResource CloseButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,5,0,0">
                        <TextBlock Text="任务标题" Foreground="#A0A0A5" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTitle" Style="{StaticResource DrawerTextBox}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkRecurring" Content=" 开启循环提醒" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,10" 
                                  Checked="ChkRecurring_Changed" Unchecked="ChkRecurring_Changed"/>

                        <Grid x:Name="panelRecurring" IsEnabled="False" Opacity="0.5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="间隔" Foreground="#A0A0A5" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtInterval" Text="1" Style="{StaticResource DrawerTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="周期" Foreground="#A0A0A5" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbUnit" Height="26" Background="#222226" Foreground="White">
                                    <ComboBoxItem Content="天 (Day)" IsSelected="True"/>
                                    <ComboBoxItem Content="周 (Week)"/>
                                    <ComboBoxItem Content="月 (Month)"/>
                                    <ComboBoxItem Content="年 (Year)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Row="2" Content="保存任务" Click="ConfirmTask_Click" 
                            Background="#2563EB" Foreground="White" BorderThickness="0" Height="30" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. 内嵌滑动抽屉：历史记录 -->
            <Border x:Name="HistoryDrawer" Background="#18181A" Panel.ZIndex="10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HistoryTransform" X="600"/>
                </Border.RenderTransform>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="打卡历史记录" Foreground="#F0F0F0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseDrawers_Click" Style="{StaticResource CloseButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 4. 内嵌滑动抽屉：软件设定 -->
            <Border x:Name="SettingsDrawer" Background="#18181A" Panel.ZIndex="10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsTransform" X="600"/>
                </Border.RenderTransform>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="软件设置" Foreground="#F0F0F0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseDrawers_Click" Style="{StaticResource CloseButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <CheckBox x:Name="chkEdgeHide" Content=" 贴边隐藏" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,4" Cursor="Hand" Checked="SettingOption_Changed" Unchecked="SettingOption_Changed"/>
                            <TextBlock Text="当鼠标离开组件时，窗体自动滑向屏幕边缘隐藏。" Foreground="#71717A" FontSize="11" TextWrapping="Wrap" Margin="18,0,0,16"/>

                            <CheckBox x:Name="chkAutoStart" Content=" 开机自动启动" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,4" Cursor="Hand" Checked="SettingOption_Changed" Unchecked="SettingOption_Changed"/>
                            <TextBlock Text="让桌面小组件在 Windows 启动时自动运行。" Foreground="#71717A" FontSize="11" TextWrapping="Wrap" Margin="18,0,0,0"/>
                        </StackPanel>

                        <!-- 小号退出程序按钮 -->
                        <Button Grid.Row="1" Content="退出程序" Click="ExitApp_Click" 
                                Background="#DC2626" Foreground="White" BorderThickness="0" 
                                Height="26" Width="100" HorizontalAlignment="Center"
                                Cursor="Hand" Margin="0,15,0,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>