<Window x:Class="DesktopCalendarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopCalendarWidget"
        Title="Desktop Widget" Height="380" Width="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- 动态颜色 Converter -->
        <local:TaskDayToBrushConverter x:Key="TaskDayToBrushConverter"/>
        <local:TaskDayToToolTipConverter x:Key="TaskDayToToolTipConverter"/>

        <Style x:Key="NoFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全局动态主题滚动条样式 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ThumbBg}" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日期按钮样式 -->
        <Style x:Key="CustomCalendarDayButton" TargetType="{x:Type CalendarDayButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=DataContext, Converter={StaticResource TaskDayToToolTipConverter}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="100"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="TaskDot" Grid.Row="1" Width="4" Height="4" Margin="0,2,0,0"
                                         HorizontalAlignment="Center"
                                         Fill="{Binding Path=DataContext, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TaskDayToBrushConverter}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 1. 默认“今天”状态：高亮蓝字+加粗 -->
                            <Trigger Property="IsToday" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>

                            <!-- 2. 非本月日期状态：浅灰字 + 隐藏小蓝点 -->
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter TargetName="TaskDot" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <!-- 3. 悬浮状态：背景微亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource ControlHoverBg}"/>
                            </Trigger>

                            <!-- 4. 选中状态（覆盖上方颜色，统一设为白色字） -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>

                            <!-- 5. 既是“今天”又被“选中”时的组合状态：保持白色字+加粗 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsToday" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubBorderBrushKey}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomCalendarButton" TargetType="{x:Type CalendarButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarButton}">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource ControlHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomCalendarItemStyle" TargetType="{x:Type CalendarItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CalendarItem}">
                        <Grid x:Name="PART_Root">
                            <Border Background="Transparent" BorderThickness="0" Padding="0">
                                <Grid Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource CalendarHeaderBtnText}"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlHoverBg}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Grid.Resources>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="&lt;" Width="28" Height="28" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                                        <Button x:Name="PART_HeaderButton" Grid.Column="1" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" Cursor="Hand"/>
                                        <Button x:Name="PART_NextButton" Grid.Column="2" Content="&gt;" Width="28" Height="28" Cursor="Hand" FontSize="14" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Grid.Row="1" x:Name="MonthViewContainer">
                                        <Grid x:Name="CustomWeekHeader" Panel.ZIndex="1" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Setter Property="FontSize" Value="10"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </Grid.Resources>
                                            <TextBlock Grid.Column="0" Text="日"/>
                                            <TextBlock Grid.Column="1" Text="一"/>
                                            <TextBlock Grid.Column="2" Text="二"/>
                                            <TextBlock Grid.Column="3" Text="三"/>
                                            <TextBlock Grid.Column="4" Text="四"/>
                                            <TextBlock Grid.Column="5" Text="五"/>
                                            <TextBlock Grid.Column="6" Text="六"/>
                                        </Grid>
                                        <Grid x:Name="PART_MonthView" Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                                <Setter TargetName="MonthViewContainer" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                                <Setter TargetName="MonthViewContainer" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource CustomCalendarItemStyle}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CustomCalendarDayButton}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource CustomCalendarButton}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Calendar}">
                        <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                            <CalendarItem x:Name="PART_CalendarItem"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Style="{TemplateBinding CalendarItemStyle}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="QuickDateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <DatePickerTextBox x:Name="PART_TextBox" 
                                                   Grid.Column="0"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                
                                <Button x:Name="PART_Button" 
                                        Grid.Column="1" 
                                        Width="30" 
                                        Focusable="False" 
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path Data="M19,4H18V2H16V4H8V2H6V4H5A2,2 0 0,0 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20M19,8H5V6H19V8Z" 
                                                      Fill="{DynamicResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                
                                <Popup x:Name="PART_Popup" 
                                       AllowsTransparency="True" 
                                       Placement="Bottom" 
                                       PlacementTarget="{Binding ElementName=PART_TextBox}" 
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <Border x:Name="BackgroundBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    HorizontalAlignment="Left"
                                                    IsHitTestVisible="False"
                                                    Content="{TemplateBinding SelectionBoxItem}"
                                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                    <Path Grid.Column="1"
                                        x:Name="ArrowPath"
                                        Data="M 0 0 L 4 4 L 8 0 Z"
                                        Fill="{DynamicResource TextSecondary}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                    <ToggleButton Grid.ColumnSpan="2"
                                                Focusable="False"
                                                ClickMode="Press"
                                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource DropDownBg}"
                                        BorderBrush="{DynamicResource SubBorderBrushKey}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource ControlHoverBg}"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource DropDownBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1.5" Margin="10" ClipToBounds="True">
        <Grid>
            <!-- 主视图层 -->
            <Grid x:Name="MainContentView" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="8">
                    <Viewbox Stretch="Uniform">
                        <Calendar Name="MainCalendar" 
                                  FirstDayOfWeek="Sunday"
                                  Style="{StaticResource CustomCalendarStyle}"
                                  SelectedDatesChanged="MainCalendar_SelectedDatesChanged"/>
                    </Viewbox>
                </Border>

                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrushKey}" HorizontalAlignment="Center"/>

                <Grid Grid.Column="2" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Tasks" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="Settings_Click" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBg}" 
                                    BorderThickness="0" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="软件设定">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextPrimary}" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.53,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.47,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.47,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.53,18.95 19.66,18.73L21.66,15.27C21.79,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            
                            <Button Click="History_Click" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBg}" 
                                    BorderThickness="0" Width="26" Height="26" Margin="0,0,6,0" Cursor="Hand" ToolTip="历史记录">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextPrimary}" Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3M12,8V13L16.28,15.54L17,14.33L13.5,12.25V8H12Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Button Content="＋" Click="AddTask_Click" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBg}" 
                                    BorderThickness="0" Width="26" Height="26" Cursor="Hand" ToolTip="新建任务">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="TaskListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 抽屉：新建/编辑任务 -->
            <Border x:Name="TaskEditDrawer" Background="{DynamicResource WindowBg}" CornerRadius="16" Panel.ZIndex="20" ClipToBounds="True" Margin="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TaskEditTransform" X="650"/>
                </Border.RenderTransform>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="lblDrawerTitle" Text="新建任务" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseDrawers_Click" Style="{StaticResource CloseButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="任务标题" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtTitle" Style="{StaticResource DrawerTextBox}" Margin="0,0,0,10"/>

                            <TextBlock Text="目标日期" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpTaskDate" Margin="0,0,0,8"/>

                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="今天" Style="{StaticResource QuickDateBtnStyle}" Click="SetToday_Click"/>
                                <Button Content="明天" Style="{StaticResource QuickDateBtnStyle}" Click="SetTomorrow_Click"/>
                                <Button Content="下周" Style="{StaticResource QuickDateBtnStyle}" Click="SetNextWeek_Click"/>
                                <Button Content="下个月" Style="{StaticResource QuickDateBtnStyle}" Click="SetNextMonth_Click"/>
                                <Button Content="明年" Style="{StaticResource QuickDateBtnStyle}" Click="SetNextYear_Click"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                    <TextBox x:Name="txtNDays" Text="3" Width="30" Style="{StaticResource DrawerTextBox}" Padding="2,2" HorizontalContentAlignment="Center"/>
                                    <Button Content="天后" Style="{StaticResource QuickDateBtnStyle}" Margin="2,0,0,0" Click="SetNDaysLater_Click"/>
                                </StackPanel>
                            </WrapPanel>

                            <CheckBox x:Name="chkRecurring" Content=" 开启循环提醒" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,8" 
                                      Checked="ChkRecurring_Changed" Unchecked="ChkRecurring_Changed"/>

                            <Grid x:Name="panelRecurring" IsEnabled="False" Opacity="0.5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="间隔" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtInterval" Text="1" Style="{StaticResource DrawerTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="周期" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbUnit" Height="28">
                                        <ComboBoxItem Content="天 (Day)" IsSelected="True"/>
                                        <ComboBoxItem Content="周 (Week)"/>
                                        <ComboBoxItem Content="月 (Month)"/>
                                        <ComboBoxItem Content="年 (Year)"/>
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox x:Name="chkShowInCalendar" Grid.Row="1" Grid.ColumnSpan="3"
                                          Content=" 在日历中提示小蓝点" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,8,0,0" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="保存任务" Click="ConfirmTask_Click" 
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Height="30" Cursor="Hand" Margin="0,10,0,0">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- 抽屉：历史记录 -->
            <Border x:Name="HistoryDrawer" Background="{DynamicResource WindowBg}" CornerRadius="16" Panel.ZIndex="20" ClipToBounds="True" Margin="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HistoryTransform" X="650"/>
                </Border.RenderTransform>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="打卡历史记录" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseDrawers_Click" Style="{StaticResource CloseButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HistoryListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 抽屉：软件设定 -->
            <Border x:Name="SettingsDrawer" Background="{DynamicResource WindowBg}" CornerRadius="16" Panel.ZIndex="20" ClipToBounds="True" Margin="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsTransform" X="650"/>
                </Border.RenderTransform>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="软件设置" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Click="CloseDrawers_Click" Style="{StaticResource CloseButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 包裹滚动条，防止内容过多超出下界 -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 新增：外观主题选择 -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="外观主题" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <ComboBox x:Name="cmbThemeMode" Width="100" HorizontalAlignment="Right" SelectionChanged="CmbThemeMode_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统" Tag="System"/>
                                        <ComboBoxItem Content="深色模式" Tag="Dark"/>
                                        <ComboBoxItem Content="浅色模式" Tag="Light"/>
                                    </ComboBox>
                                </DockPanel>

                                <CheckBox x:Name="chkEdgeHide" Content=" 贴边隐藏" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,4" Cursor="Hand" Checked="SettingOption_Changed" Unchecked="SettingOption_Changed"/>
                                <TextBlock Text="当鼠标离开组件时，窗体自动滑向屏幕边缘隐藏。" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="18,0,0,16"/>

                                <CheckBox x:Name="chkAutoStart" Content=" 开机自动启动" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,4" Cursor="Hand" Checked="SettingOption_Changed" Unchecked="SettingOption_Changed"/>
                                <TextBlock Text="让桌面小组件在 Windows 启动时自动运行。" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="18,0,0,16"/>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="窗口不透明度" Foreground="{DynamicResource TextPrimary}" FontSize="12" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="txtOpacityValue" Text="100%" Foreground="{DynamicResource AccentLightBrush}" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <Slider x:Name="sliderOpacity" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        ValueChanged="SliderOpacity_ValueChanged" Cursor="Hand" IsMoveToPointEnabled="True"/>
                                <TextBlock Text="拖动以调整窗口透明度（最低 10%），个人推荐60% - 70%左右。" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <!-- 喝水提醒分割线和设置区块 -->
                                <Rectangle Height="1" Fill="{DynamicResource SubBorderBrushKey}" Margin="0,15,0,15"/>
                                
                                <TextBlock Text="喝水提醒" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="chkWaterEnable" Content=" 开启喝水提醒" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,10" Cursor="Hand" Checked="WaterSetting_Changed" Unchecked="WaterSetting_Changed"/>
                                
                                <Grid x:Name="panelWaterConfig" Margin="18,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="每日提醒次数" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtWaterTimes" Width="50" HorizontalAlignment="Right" Style="{StaticResource DrawerTextBox}" TextAlignment="Center" LostFocus="WaterSetting_LostFocus"/>
                                    </DockPanel>
                                    
                                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="开始时间 (HH:mm)" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtWaterStartTime" Width="50" HorizontalAlignment="Right" Style="{StaticResource DrawerTextBox}" TextAlignment="Center" LostFocus="WaterSetting_LostFocus"/>
                                    </DockPanel>
                                    
                                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                        <TextBlock Text="间隔时间" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox x:Name="txtWaterHour" Width="30" Style="{StaticResource DrawerTextBox}" TextAlignment="Center" LostFocus="WaterInterval_LostFocus"/>
                                            <TextBlock Text=" 时 " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="2,0"/>
                                            <TextBox x:Name="txtWaterMin" Width="30" Style="{StaticResource DrawerTextBox}" TextAlignment="Center" LostFocus="WaterInterval_LostFocus"/>
                                            <TextBlock Text=" 分 " Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="2,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="1" Content="退出程序" Click="ExitApp_Click" 
                                Background="#DC2626" Foreground="White" BorderThickness="0" 
                                Height="26" Width="100" HorizontalAlignment="Center"
                                Cursor="Hand" Margin="0,5,0,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>